<Shell
    x:Class="GestaoEstudioTatuagem.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GestaoEstudioTatuagem.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="Gestão Estúdio Tatuagem">

    <!-- Tela inicial (não aparece no menu) -->
    <ShellContent 
        Title="Home" 
        ContentTemplate="{DataTemplate views:Home}" 
        Route="Home" />

    <!-- Telas no menu lateral -->
    <FlyoutItem Title="Login">
        <ShellContent 
            Title="Login Cliente" 
            ContentTemplate="{DataTemplate views:LoginCliente}" 
            Route="LoginCliente" />
    </FlyoutItem>

    <FlyoutItem Title="Login Tatuador">
        <ShellContent 
            Title="Login Tatuador" 
            ContentTemplate="{DataTemplate views:LoginTatuador}" 
            Route="LoginTatuador" />
    </FlyoutItem>

    <FlyoutItem Title="Dashboard">
        <ShellContent 
            Title="Dashboard" 
            ContentTemplate="{DataTemplate views:Dashboard}" 
            Route="Dashboard" />
    </FlyoutItem>

    <FlyoutItem Title="Agenda">
        <ShellContent 
            Title="Agenda" 
            ContentTemplate="{DataTemplate views:Agenda}" 
            Route="Agenda" />
    </FlyoutItem>

    <FlyoutItem Title="Clientes">
        <ShellContent 
            Title="Lista de Clientes" 
            ContentTemplate="{DataTemplate views:ListaDeClientes}" 
            Route="ListaDeClientes" />
    </FlyoutItem>

    <FlyoutItem Title="Tatuadores">
        <ShellContent 
            Title="Lista de Tatuadores" 
            ContentTemplate="{DataTemplate views:TatuadorPage}" 
            Route="TatuadorPage" />
    </FlyoutItem>

    <ShellContent 
        Title="Cadastro" 
        ContentTemplate="{DataTemplate views:TelaDeCadastro}" 
        Route="TelaDeCadastro" />
</Shell>
