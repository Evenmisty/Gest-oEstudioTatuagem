<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestaoEstudioTatuagem.Views.Agenda"
             xmlns:viewmodels="clr-namespace:GestaoEstudioTatuagem.ViewModels"
             Title="Agenda">

    <ContentPage.BindingContext>
        <viewmodels:AgendaViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Lista de Agendamentos"
                   FontSize="Title"
                   HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding Sessoes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="LightGray" Padding="10" Margin="0,5">
                            <VerticalStackLayout>
                                <Label Text="{Binding Cliente.Nome}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Tatuador.Nome}" FontSize="14" TextColor="Gray" />
                                <Label Text="{Binding DataSessao, StringFormat='Agendado para: {0:dd/MM/yyyy HH:mm}'}" FontSize="12" />
                                <Label Text="{Binding DescricaoTatuagem}" FontSize="12" TextColor="DarkGray" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
