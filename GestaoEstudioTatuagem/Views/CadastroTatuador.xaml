<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GestaoEstudioTatuagem.ViewModels"
             x:Class="GestaoEstudioTatuagem.Views.CadastroTatuador"
             Title="Cadastro Estúdio">

    <ContentPage.BindingContext>
        <viewmodels:CadastroTatuadorViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- Imagem de fundo -->
        <Image Source="plano_de_fundo.jpg"
               Aspect="AspectFill"
               Opacity="0.5"/>

        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

                <!-- Card com logo e campos -->
                <Frame BackgroundColor="#e3dcce"
                       CornerRadius="20"
                       Padding="25"
                       HasShadow="True"
                       BorderColor="Transparent">

                    <VerticalStackLayout Spacing="15">

                        <!-- Logo -->
                        <Image Source="logo.png"
                               HeightRequest="200"
                               HorizontalOptions="Center" />

                        <!-- Títulos -->
                        <Label Text="Cadastro"
                               FontSize="40"
                               HorizontalOptions="Center"
                               TextColor="#49423c"
                               FontFamily="PoppinsSemiBold"
                               FontAttributes="Bold"/>

                        <Label Text="Acesso do Estúdio"
                               FontSize="25"
                               HorizontalOptions="Center"
                               TextColor="#77453f"
                               FontFamily="Questrial"
                               FontAttributes="Bold"/>

                        <Label Text="Preencha os dados do estúdio para continuar"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="#49423c"
                               FontFamily="DMSansExtraLight"/>

                        <!-- E-mail -->
                        <Label Text="E-mail" TextColor="#49423c"/>
                        <Entry Placeholder="seu@email.com"
                               Text="{Binding Email}"
                               Keyboard="Email"
                               BackgroundColor="#49423c"
                               TextColor="#e3dcce"
                               PlaceholderColor="#e3dcce"/>

                        <!-- Senha -->
                        <Label Text="Senha" TextColor="#49423c"/>
                        <Entry Placeholder="••••••••"
                               Text="{Binding Senha}"
                               IsPassword="True"
                               BackgroundColor="#49423c"
                               TextColor="#e3dcce"
                               PlaceholderColor="#e3dcce"/>

                        <!-- Nome do Estúdio -->
                        <Label Text="Nome do Estúdio" TextColor="#49423c"/>
                        <Entry Placeholder="Nome fantasia"
                               Text="{Binding Nome}"
                               BackgroundColor="#49423c"
                               TextColor="#e3dcce"
                               PlaceholderColor="#e3dcce"/>

                        <!-- CNPJ (opcional) -->
                        <Label Text="CNPJ (opcional)" TextColor="#49423c"/>
                        <Entry Placeholder="00.000.000/0000-00"
                               Text="{Binding CNPJ}"
                               Keyboard="Numeric"
                               BackgroundColor="#49423c"
                               TextColor="#e3dcce"
                               PlaceholderColor="#e3dcce"/>

                        <!-- Especialidade -->
                        <Label Text="Especialidade" TextColor="#49423c"/>
                        <Entry Placeholder="Ex.: Realismo, Old School..."
                               Text="{Binding Especialidade}"
                               BackgroundColor="#49423c"
                               TextColor="#e3dcce"
                               PlaceholderColor="#e3dcce"/>

                        <!-- Endereço -->
                        <Label Text="Endereço" TextColor="#49423c"/>
                        <Entry Placeholder="Rua, número, bairro, cidade"
                               Text="{Binding Endereco}"
                               BackgroundColor="#49423c"
                               TextColor="#e3dcce"
                               PlaceholderColor="#e3dcce"/>

                        <!-- Telefone/WhatsApp -->
                        <Label Text="Telefone/WhatsApp" TextColor="#49423c"/>
                        <Entry Placeholder="(00) 00000-0000"
                               Text="{Binding Telefone}"
                               Keyboard="Telephone"
                               BackgroundColor="#49423c"
                               TextColor="#e3dcce"
                               PlaceholderColor="#e3dcce"/>

                        <!-- Portfólio (Instagram) -->
                        <Label Text="Instagram (opcional)" TextColor="#49423c"/>
                        <Entry Placeholder="Ex.: @seuInstagram ou deixe em branco"
                               Text="{Binding Instagram}"
                               BackgroundColor="#49423c"
                               TextColor="#e3dcce"
                               PlaceholderColor="#e3dcce"/>


                        <!-- Descrição -->
                        <Label Text="Descrição do Estúdio" TextColor="#49423c"/>
                        <Entry Placeholder="Fale sobre seu estúdio, estilos, etc."
                               Text="{Binding Descricao}"
                               BackgroundColor="#49423c"
                               TextColor="#e3dcce"
                               PlaceholderColor="#e3dcce"/>

                        <!-- Botão cadastrar -->
                        <Button Text="Cadastrar"
                                Command="{Binding CadastrarCommand}"
                                BackgroundColor="#4a755e"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="50"/>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
