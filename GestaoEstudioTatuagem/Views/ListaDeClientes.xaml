<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GestaoEstudioTatuagem.ViewModels"
             x:Class="GestaoEstudioTatuagem.Views.ListaDeClientes"
             Title="Clientes">

    <ContentPage.BindingContext>
        <viewmodels:ListaDeClientesViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- IMAGEM DE FUNDO -->
        <Image Source="plano_de_fundo.jpg"
               Aspect="AspectFill"
               Opacity="0.5"
               IsVisible="True" />

        <VerticalStackLayout Padding="20">

            <Frame BackgroundColor="#e3dcce"
                   CornerRadius="20"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="Transparent">

                <VerticalStackLayout Spacing="15">

                    <!-- TÍTULO -->
                    <Label Text="CLIENTES"
                           FontSize="32"
                           HorizontalOptions="Center"
                           FontFamily="Questrial"
                           TextColor="#49423c"/>

                    <!-- BUSCA E FILTRO -->
                    <HorizontalStackLayout Spacing="10">
                        <Entry Placeholder="Buscar cliente..." 
                               Text="{Binding SearchQuery}" 
                               HorizontalOptions="FillAndExpand"
                               PlaceholderColor="#9f8f7f"
                               TextColor="#49423c"
                               FontFamily="PoppinsRegular"/>

                        <Picker Title="Filtrar por"
                                ItemsSource="{Binding FilterOptions}" 
                                SelectedItem="{Binding SelectedFilter}" 
                                WidthRequest="160"/>
                    </HorizontalStackLayout>

                    <!-- BOTÃO ADICIONAR -->
                    <Button Text="Novo Cliente"
                            Command="{Binding AddClientCommand}"
                            BackgroundColor="#4a755e"
                            TextColor="#e3dcce"
                            CornerRadius="10"
                            FontFamily="PoppinsExtraBold"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            Margin="0,10"/>

                    <!-- LISTA DE CLIENTES -->
                    <CollectionView ItemsSource="{Binding Clients}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="#9f8f7f"
                                       BackgroundColor="#77453f"
                                       Padding="15"
                                       CornerRadius="10"
                                       Margin="0,5">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Nome}" 
                                               FontSize="18" 
                                               FontAttributes="Bold"
                                               TextColor="#e3dcce"
                                               FontFamily="DMSansLight"/>
                                        <Label Text="{Binding Telefone}" 
                                               FontSize="14"
                                               TextColor="#9f8f7f"/>
                                        <Label Text="{Binding CPF}" 
                                               FontSize="14"
                                               TextColor="#9f8f7f"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
