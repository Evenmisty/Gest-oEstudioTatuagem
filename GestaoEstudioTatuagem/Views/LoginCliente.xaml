<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GestaoEstudioTatuagem.ViewModels"
             x:Class="GestaoEstudioTatuagem.Views.LoginCliente">

    <ContentPage.BindingContext>
        <viewmodels:TelaDeLoginViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- IMAGEM DE FUNDO -->
        <Image Source="plano_de_fundo.jpg"
               Aspect="AspectFill"
               Opacity="0.5"
               IsVisible="True" />

        <!-- CONTEÚDO -->
        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

                <!-- CARD COM FRAME (incluindo logo e títulos) -->
                <Frame BackgroundColor="#e3dcce"
                       CornerRadius="20"
                       Padding="25"
                       HasShadow="True"
                       BorderColor="Transparent">

                    <VerticalStackLayout Spacing="15">

                        <!-- LOGO -->
                        <Image Source="logo.png"
                               HeightRequest="200"
                               HorizontalOptions="Center" />

                        <!-- Título -->
                        <Label Text="Login"
                               FontSize="40"
                               HorizontalOptions="Center"
                               TextColor="#49423c"
                               FontFamily="PoppinsSemiBold"/>

                        <Label Text="Acesso do Cliente"
                               FontSize="25"
                               HorizontalOptions="Center"
                               TextColor="#77453f"
                               FontFamily="Questrial"
                               FontAttributes="Bold"/>

                        <Label Text="Faça login para continuar"
                               FontSize="16"
                               HorizontalOptions="Center"
                               TextColor="#49423c"
                               FontFamily="DMSansExtraLight"/>

                        <!-- Email -->
                        <Label Text="E-mail" TextColor="#49423c" FontFamily="DMSansExtraLight"/>
                        <Entry Placeholder="seu@email.com"
                               Text="{Binding Email}"
                               Keyboard="Email"
                               BackgroundColor="#49423c"
                               TextColor="#e3dcce"
                               PlaceholderColor="#e3dcce"
                               FontFamily="PoppinsRegular"
                               HorizontalOptions="FillAndExpand"/>

                        <!-- Senha -->
                        <Label Text="Senha" TextColor="#49423c" FontFamily="DMSansExtraLight"/>
                        <StackLayout Orientation="Horizontal">
                            <Entry Placeholder="••••••••"
                                   Text="{Binding Password}"
                                   IsPassword="{Binding IsPasswordHidden}"
                                   BackgroundColor="#49423c"
                                   TextColor="#e3dcce"
                                   PlaceholderColor="#e3dcce"
                                   FontFamily="PoppinsRegular"
                                   HorizontalOptions="FillAndExpand"/>
                            <ImageButton Source="eye_icon.png"
                                         Command="{Binding TogglePasswordCommand}"
                                         BackgroundColor="Transparent"
                                         WidthRequest="30"
                                         HeightRequest="30"/>
                        </StackLayout>

                        <!-- Botão Login -->
                        <Button Text="Entrar"
                                Command="{Binding SubmitCommand}"
                                BackgroundColor="#800020"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="50"/>

                        <!-- Esqueci minha senha -->
                        <Label Text="Esqueci minha senha"
                               TextColor="#4a755e"
                               FontAttributes="Bold"
                               FontFamily="DMSansExtraLight"
                               HorizontalOptions="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Cadastro -->
                        <StackLayout Orientation="Horizontal"
                                     HorizontalOptions="Center"
                                     Spacing="5">
                            <Label Text="Não tem uma conta?" TextColor="#555"/>
                            <Label Text="Cadastre-se"
                                   TextColor="#4a755e"
                                   FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToCadastroCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </StackLayout>

                    </VerticalStackLayout>

                </Frame>
                <!-- FIM DO CARD -->

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>